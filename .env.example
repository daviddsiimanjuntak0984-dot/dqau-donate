# Example only — replace both values in your local .env.local before running the app.
# Do not copy a project URL from an old project or another environment.
# Use the URL and public publishable/anon key from the SAME Supabase project.
# This file intentionally contains no real project reference or credential.
#
# Safe for the browser: a Supabase publishable key (sb_publishable_...) or legacy anon key.
# NEVER use service_role, sb_secret_*, database passwords, or payment secrets here.
VITE_SUPABASE_URL=REPLACE_ME
VITE_SUPABASE_ANON_KEY=REPLACE_ME
